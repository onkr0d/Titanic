# Required:
FIREBASE_PROJECT_ID=id

# Optional, if values not provided, defaults are used:
IS_DEV=boolean # default: false
# Disables Firebase auth. Local dev ONLY — requires IS_DEV=true as well, and must
# never be set in production. default: false
DEV_AUTH_BYPASS=boolean
BIND_ADDRESS=0.0.0.0:3029 # upload/API listener, default is 0.0.0.0:3029
# Settings listener (settings page + settings read/write). Default 0.0.0.0:3031.
# 0.0.0.0 is correct: it means all interfaces of the *container's* namespace, which
# is how Umbrel's app_proxy reaches it. Keep this port out of any `ports:` mapping.
SETTINGS_BIND_ADDRESS=0.0.0.0:3031
PLEX_MEDIA_PATH=/downloads # default: /downloads
SENTRY_DNS=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=